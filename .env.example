# Copy to .env and fill in.

ENV=test                       # "prod" uses DB_URL, anything else uses DB_TEST_URL
DB_URL=postgres://user:pass@localhost:5432/sf_cars?sslmode=disable
DB_TEST_URL=postgres://user:pass@localhost:5432/sf_cars_test?sslmode=disable

BIND_ADDR_PUBLIC=              # empty = all interfaces
PORT=8080

# Generated workbooks are archived here as <prefix>YYYY-MM-DD.xlsx
ABSOLUTE_DIRECTORY=/srv/sf_reports/
FILENAME_PREFIX=grounded_
FILENAME_PREFIX_FINAL_REPORT=final_report_
FILENAME_PREFIX_NATIONWIDE=nationwide_

# Templates + Airport_Codes.xlsx (see sf_server_utils README)
SF_ASSETS_DIR=/home/you/workspace/github.com/jamjallred/sf_server_utils/assets

# Sales reps credited on the final report and shown in the profile picker.
# Read in order until the first missing number.
EMPLOYEE_1=
EMPLOYEE_2=
EMPLOYEE_3=
EMPLOYEE_4=

# Avis price check (/app/price_check). The server downloads the used inventory
# from aviscarsales.com one page (48 cars) at a time, pausing between requests,
# and reuses the result until it is older than AVIS_CACHE_TTL.
AVIS_REQUEST_DELAY=6s          # pause between requests (robots.txt Crawl-delay wins if longer)
AVIS_CACHE_TTL=6h
AVIS_USER_AGENT=SoonerFleet-PriceCheck/1.0
